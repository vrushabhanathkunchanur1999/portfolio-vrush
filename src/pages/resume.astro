---
// HTML version of public/resume.pdf. The content comes from profile.ts; keep the PDF in step with it.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Section from '@/components/Section.astro';
import SkillList from '@/components/SkillList.astro';
import DateRange from '@/components/DateRange.astro';
import { awards, education, experience, summary } from '@/lib/profile';
import { site } from '@/lib/site';
---

<BaseLayout
  title="Résumé: Vrushabh Kunchanur, AI Engineer"
  description="Résumé of Vrushabh Kunchanur, AI engineer: computer vision on 400+ retail edge devices and a 4-station inspection line, plus 3.5 years of real-time 3D work."
>
  <div class="sheet pt-10 md:pt-14">
    <div>
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Résumé', href: '/resume' },
        ]}
      />
      <h1 class="mt-6">Résumé</h1>
      <p class="mt-3 text-lg">
        {site.name}, {site.jobTitle}, {site.location.locality}, {site.location.region},{' '}
        {site.location.country}
      </p>
      <p class="mt-4">
        <a class="tap bg-ink px-5 font-semibold text-paper no-underline hover:underline" href="/resume.pdf">
          Download résumé (PDF)
        </a>
      </p>
    </div>
  </div>

  <Section id="summary" label="Summary">
    <p class="measure">{summary}</p>
  </Section>

  <Section id="experience" label="Experience">
    <div class="grid gap-12">
      {
        experience.map((r) => (
          <article aria-labelledby={`role-${r.start.iso}`}>
            <h3 id={`role-${r.start.iso}`} class="text-xl">
              {r.role}, {r.org}
            </h3>
            <p class="text-graphite tabular-nums">
              {r.location}. <DateRange start={r.start} end={r.end} />
            </p>
            {r.projects?.map((p) => (
              <div class="mt-6">
                <h4 class="font-semibold">
                  {p.caseStudy ? <a href={`/projects/${p.caseStudy}`}>{p.name}</a> : p.name}
                </h4>
                <p class="measure text-graphite">{p.context}</p>
                <ul class="measure mt-3 grid list-disc gap-2 pl-6">
                  {p.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
            ))}
            {r.highlights && (
              <ul class="measure mt-4 grid list-disc gap-2 pl-6">
                {r.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="skills" label="Technical skills">
    <SkillList />
  </Section>

  <Section id="education" label="Education">
    <div class="measure">
      <h3 class="text-lg">{education.institution}</h3>
      <p>{education.degree}, {education.location}</p>
      <p class="text-graphite tabular-nums">
        <DateRange start={education.start} end={education.end} />
      </p>
      <p class="mt-2">{education.grade}. Coursework: {education.coursework.join(', ')}.</p>
    </div>
  </Section>

  <Section id="awards" label="Awards and certifications">
    <ul class="measure grid gap-3" role="list">
      {
        awards.map((a) => (
          <li>
            <p class="font-semibold">{a.title}</p>
            <p>{a.detail}</p>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
