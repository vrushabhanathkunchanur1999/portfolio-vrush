---
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { ogPath } from '@/lib/og';
import { graph, person, website, type JsonLdNode } from '@/lib/schema';
import { assertMeta, canonicalUrl } from '@/lib/seo';
import { absoluteUrl, site } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  // Key into the OG card list in lib/og.ts.
  og: string;
  // Page-specific JSON-LD nodes; Person and WebSite are always added.
  schema?: JsonLdNode[];
  article?: { publishedAt: Date; modifiedAt: Date; tags: string[] };
  noindex?: boolean;
}

const { title, description, og, schema = [], article, noindex = false } = Astro.props;
assertMeta(Astro.url.pathname, title, description);

const canonical = canonicalUrl(Astro.url.pathname);
const ogImage = absoluteUrl(ogPath(og));
const jsonLd = graph([person(), website(), ...schema]);
// Cloudflare Web Analytics: cookieless, and only rendered in production builds with a token set.
const beaconToken = import.meta.env.PROD ? import.meta.env.PUBLIC_CF_BEACON_TOKEN : undefined;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Runs before first paint so a stored theme never flashes. Storage can throw in
      // private windows; the page then falls back to the system preference.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link
      rel="preload"
      href="/fonts/archivo-latin-wdth-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#eef0f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1e21" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}, blog`} href="/rss.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.jobTitle}: ${title}`} />
    <meta property="og:locale" content="en_IN" />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedAt.toISOString()} />
          <meta property="article:modified_time" content={article.modifiedAt.toISOString()} />
          <meta property="article:author" content={absoluteUrl('/about')} />
          {article.tags.map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLd} />
    {
      beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beaconToken })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
