---
import { readouts } from '@/lib/profile';
import { site } from '@/lib/site';
---

<section aria-labelledby="hero-title" class="sheet pt-12 pb-16 md:pt-20">
  <div class="md:col-[1/-1]">
    <h1 id="hero-title">{site.name}</h1>
    <p class="mt-1 text-xl font-semibold text-graphite">{site.jobTitle}</p>
    <p class="measure mt-6 text-lg">
      I train detection, classification and anomaly models and ship them to production: 400+ retail
      stores on Raspberry Pi 5 edge devices, and 4 factory inspection stations.
    </p>

    <ul class="readouts mt-12 grid gap-10 md:grid-cols-3 md:gap-8" role="list">
      {
        readouts.map((r, i) => (
          <li style={`--i: ${i}`}>
            <p class="readout-value">
              {r.value}
              <span class="readout-unit">{r.unit}</span>
            </p>
            <div class="readout-scale" aria-hidden="true" />
            {i === 0 && <div class="readout-tape" aria-hidden="true" />}
            <p class="mt-3 text-graphite">{r.caption}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3">
      <a
        href="/projects"
        class="tap bg-ink px-5 font-semibold text-paper no-underline hover:underline"
      >
        See the case studies
      </a>
      <a href="/resume.pdf" class="tap font-semibold">Download résumé (PDF)</a>
    </div>
    <p class="mt-6 text-graphite">
      {site.location.locality}, {site.location.country}. {site.availability}
    </p>
  </div>
</section>

<style>
  .readout-value {
    font-size: var(--text-readout);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.95;
    font-variant-numeric: tabular-nums lining-nums;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .readout-unit {
    display: block;
    margin-top: 0.4rem;
    font-size: var(--text-lg);
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: 0;
    line-height: 1.2;
    color: var(--graphite);
  }

  /* A measuring scale under each number: baseline, minor ticks every 8px, major every 40px. */
  .readout-scale {
    height: 14px;
    margin-top: 0.75rem;
    background:
      linear-gradient(var(--ink), var(--ink)) bottom / 100% 1px no-repeat,
      repeating-linear-gradient(to right, var(--ink) 0 1px, transparent 1px 40px) bottom / 100% 14px
        no-repeat,
      repeating-linear-gradient(to right, var(--graphite) 0 1px, transparent 1px 8px) bottom / 100%
        6px no-repeat;
    transform-origin: left;
    animation: draw-scale 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 150ms);
  }

  .readout-tape {
    height: 6px;
    margin-top: 3px;
    width: 40%;
    background: var(--tape);
  }

  @keyframes draw-scale {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
