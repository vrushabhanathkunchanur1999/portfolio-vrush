---
import type { Crumb } from '@/lib/seo';

interface Props {
  items: Crumb[];
}

// The last item is the current page.
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-graphite">
  <ol class="flex flex-wrap gap-x-2" role="list">
    {
      items.map((item, i) => {
        const current = i === items.length - 1;
        return (
          <li class="flex gap-x-2">
            {current ? (
              <a class="tap text-graphite no-underline" href={item.href} aria-current="page">
                {item.label}
              </a>
            ) : (
              <>
                <a class="tap text-graphite" href={item.href}>
                  {item.label}
                </a>
                <span class="tap" aria-hidden="true">/</span>
              </>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
