---
interface Props {
  caption: string;
  outcomes: { metric: string; value: string; note?: string | undefined }[];
}

const { caption, outcomes } = Astro.props;
---

<div class="overflow-x-auto">
  <table class="w-full border-collapse text-left">
    <caption class="mb-3 text-left text-graphite">{caption}</caption>
    <thead>
      <tr class="border-b border-ink">
        <th scope="col" class="py-2 pr-4 font-semibold">Metric</th>
        <th scope="col" class="py-2 pr-4 font-semibold">Result</th>
        <th scope="col" class="py-2 font-semibold">Baseline and conditions</th>
      </tr>
    </thead>
    <tbody>
      {
        outcomes.map((o) => (
          <tr class="border-b border-rule align-top">
            <th scope="row" class="py-2 pr-4 font-normal">{o.metric}</th>
            <td class="py-2 pr-4 font-semibold whitespace-nowrap">{o.value}</td>
            <td class="py-2 text-graphite">{o.note}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
