---
// Progressive enhancement: without JS the buttons stay hidden and every category is shown.
interface Props {
  groups: { id: string; label: string }[];
}

const { groups } = Astro.props;
const options = [{ id: 'all', label: 'All' }, ...groups];
---

<div class="project-filter mt-8 hidden flex-wrap gap-2" role="group" aria-label="Filter projects by category">
  {
    options.map((o) => (
      <button
        type="button"
        class="tap border border-ink px-4 text-ink aria-pressed:bg-ink aria-pressed:text-paper"
        data-filter={o.id}
        aria-pressed={o.id === 'all' ? 'true' : 'false'}
      >
        {o.label}
      </button>
    ))
  }
</div>

<style>
  :global(html.js) .project-filter {
    display: flex;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.project-filter [data-filter]');
  const sections = document.querySelectorAll<HTMLElement>('[data-category]');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      sections.forEach((s) => {
        s.hidden = filter !== 'all' && s.dataset.category !== filter;
      });
    });
  });
</script>
