---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { nav, site } from '@/lib/site';

const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-b border-rule">
  <div
    class="mx-auto flex max-w-[72rem] flex-wrap items-center justify-between gap-x-6 px-4 md:flex-nowrap md:px-8"
  >
    <a href="/" class="tap font-bold text-ink no-underline" aria-current={path === '' ? 'page' : undefined}>
      {site.name}
    </a>
    <nav aria-label="Primary" class="order-last w-full md:order-none md:ml-auto md:w-auto">
      <ul class="flex flex-wrap gap-x-5">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="tap text-ink no-underline hover:underline aria-[current=page]:underline"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
